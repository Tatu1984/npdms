# NPDMS API Environment Variables
# Copy this file to .env and fill in the values

# ===========================================
# REQUIRED VARIABLES
# ===========================================

# Database connection string
DATABASE_URL=postgres://npdms:your_password@localhost:5432/npdms?sslmode=disable

# JWT secret key (min 32 characters, use a random string)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# MinIO/S3 configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio_access_key
MINIO_SECRET_KEY=minio_secret_key
MINIO_BUCKET=npdms-files
MINIO_USE_SSL=false

# ===========================================
# OPTIONAL VARIABLES (with defaults)
# ===========================================

# Server configuration
PORT=8080
ENV=development
GIN_MODE=debug

# Redis configuration
REDIS_URL=redis://localhost:6379

# CORS configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ===========================================
# ML SERVICE URLS (optional, for AI features)
# ===========================================

ML_FIR_CLASSIFIER_URL=http://localhost:8001
ML_SEMANTIC_SEARCH_URL=http://localhost:8002
ML_CRIME_PREDICTION_URL=http://localhost:8003
ML_OCR_URL=http://localhost:8004
ML_TRANSCRIPTION_URL=http://localhost:8005

# ===========================================
# GRAPH DATABASE (optional, for network analysis)
# ===========================================

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j_password

# ===========================================
# KAFKA/MESSAGING (optional, for event streaming)
# ===========================================

KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=npdms-api

# ===========================================
# VAULT (optional, for secrets management)
# ===========================================

VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=root

# ===========================================
# LOGGING
# ===========================================

LOG_LEVEL=info
LOG_FORMAT=json
